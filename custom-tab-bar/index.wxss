.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(15, 118, 110, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  position: relative;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: #0f766e;
  font-weight: 700;
}

/* 中间凸起按钮 */
.tab-center {
  position: relative;
}

.center-btn {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.35);
  border: 6rpx solid #ffffff;
}

.center-icon {
  width: 52rpx;
  height: 52rpx;
}

.center-text {
  position: absolute;
  bottom: 8rpx;
  color: #0f766e;
  font-weight: 700;
  font-size: 22rpx;
}
