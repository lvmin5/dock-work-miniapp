page {
  min-height: 100%;
  background: #f0fdf4;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  border-radius: 8rpx;
}

button::after {
  border: 0;
}

input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border: 2rpx solid #ccfbf1;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(15, 118, 110, 0.06);
}

.section-title {
  color: #134e4a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.muted {
  color: #94a3b8;
  font-size: 24rpx;
}

.empty {
  padding: 80rpx 20rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  color: #94a3b8;
  font-size: 28rpx;
  text-align: center;
  background: #ffffff;
}

.primary-button {
  height: 88rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.25);
}

.primary-button[disabled] {
  color: #ffffff;
  background: #cbd5e1;
  box-shadow: none;
}
