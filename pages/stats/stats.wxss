.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 180rpx;
  background: #f0fdf4;
  box-sizing: border-box;
}

.header-card {
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.25);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.rate-entry {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.mode-list {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.mode {
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.12);
  transition: all 0.15s;
}

.mode.active {
  color: #0f766e;
  font-weight: 700;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.period-picker {
  padding: 22rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  background: rgba(255, 255, 255, 0.12);
}

.summary-card {
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #115e59 0%, #0f766e 100%);
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.25);
  text-align: center;
}

.summary-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.summary-value {
  color: #fbbf24;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.table-scroll {
  width: 100%;
}

.stat-block {
  margin-bottom: 24rpx;
}

.stat-title {
  margin: 0 0 14rpx;
  color: #134e4a;
  font-size: 30rpx;
  font-weight: 700;
  padding-left: 16rpx;
  border-left: 6rpx solid #0f766e;
}

.table {
  min-width: 760rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 118, 110, 0.06);
}

.table-row {
  display: flex;
  min-height: 80rpx;
  border-bottom: 2rpx solid #f0fdf4;
}

.table-row:last-child {
  border-bottom: 0;
}

.table-head {
  background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
}

.table-head .cell {
  color: #ffffff;
  font-weight: 700;
  border-right: 2rpx solid rgba(255, 255, 255, 0.15);
}

.table-row:nth-child(even):not(.table-head) {
  background: #f8fafc;
}

.cell {
  width: 160rpx;
  padding: 20rpx 16rpx;
  border-right: 2rpx solid #f0fdf4;
  color: #1e293b;
  font-size: 26rpx;
  line-height: 1.35;
  box-sizing: border-box;
}

.cell:last-child {
  border-right: 0;
}

.type {
  width: 210rpx;
  font-weight: 700;
  color: #134e4a;
}

.quantity {
  width: 190rpx;
  text-align: right;
  font-weight: 700;
  color: #0f766e;
}

.amount {
  width: 190rpx;
  text-align: right;
  font-weight: 700;
  color: #f59e0b;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}
